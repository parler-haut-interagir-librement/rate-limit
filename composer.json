{
    "name": "phil/rate-limit",
    "description": "The production guard of rate limits over symfony/rate-limiter: a compiler pass that fails the container build on a limiter counting in a cache pool or a storage each server keeps for itself, and on a rate limit enabled without the component",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "rate-limit",
        "rate-limiter",
        "symfony",
        "compiler-pass",
        "cache",
        "production"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "roave/security-advisories": "dev-latest",
        "symfony/cache": "^8.2",
        "symfony/rate-limiter": "^8.2"
    },
    "suggest": {
        "symfony/rate-limiter": "The rate limiter whose stores the guard checks, and that requireComponent() asks for"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\RateLimit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\RateLimit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
